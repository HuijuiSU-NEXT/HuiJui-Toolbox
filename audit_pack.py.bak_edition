# audit_pack.py  ·  打包前资源审计
import os
import re
import sys

BASE = os.path.dirname(os.path.abspath(__file__))
BIN = os.path.join(BASE, "bin")
ASSETS = os.path.join(BASE, "assets")
SKIP = {"dist", "build", "__pycache__", ".venv", "venv", ".git", "temp_ota_work"}


def walk_py(base):
    out = []
    for root, dirs, files in os.walk(base):
        dirs[:] = [d for d in dirs if d not in SKIP and not d.startswith(".")]
        out += [os.path.join(root, f) for f in files if f.endswith(".py")]
    return out


print("=" * 70)
print("📦 打包前资源审计")
print("=" * 70)

# ---------- 1. bin / assets 树 ----------
for label, d in [("bin", BIN), ("assets", ASSETS)]:
    print(f"\n📁 {label}/ 结构:")
    if not os.path.isdir(d):
        print(f"  [X] 不存在")
        continue
    for root, _, files in os.walk(d):
        rel = os.path.relpath(root, d)
        depth = 0 if rel == "." else rel.count(os.sep) + 1
        if rel != ".":
            print("  " * depth + os.path.basename(root) + "/")
        for f in sorted(files):
            p = os.path.join(root, f)
            s = os.path.getsize(p)
            sz = f"{s/1024/1024:.1f}MB" if s > 1024*1024 else f"{s/1024:.0f}KB"
            print("  " * (depth + 1) + f"{f}  ({sz})")

# ---------- 2. main_final.py 的 import 方式（查动态导入漏点） ----------
print("\n🔍 main_final.py 导入方式（查动态 import）:")
mf = os.path.join(BASE, "main_final.py")
if os.path.isfile(mf):
    with open(mf, "r", encoding="utf-8", errors="ignore") as f:
        for i, line in enumerate(f, 1):
            l = line.strip()
            if l.startswith(("import ", "from ")) or "import_module" in l or "__import__" in l:
                print(f"  {i:3}: {l}")
else:
    print("  [!] 没找到 main_final.py")

# ---------- 3. BASE_DIR 计算方式（查打包后路径解析） ----------
print("\n🔍 BASE_DIR 计算方式:")
for py in walk_py(BASE):
    with open(py, "r", encoding="utf-8", errors="ignore") as f:
        for i, line in enumerate(f, 1):
            if "BASE_DIR" in line and "=" in line and ("abspath" in line or "__file__" in line or "argv" in line):
                print(f"  {os.path.relpath(py, BASE)}:{i}: {line.strip()}")

# ---------- 4. 运行时残留（打包前必删） ----------
print("\n🧹 运行时残留（进 dist 会爆炸）:")
junk_files = ["payload.bin", "ota_update.zip", "profile.conf"]
found_junk = False
for name in junk_files:
    p = os.path.join(BASE, name)
    if os.path.exists(p):
        print(f"  [!] {p}  ({os.path.getsize(p)/1024/1024:.1f}MB)")
        found_junk = True
if os.path.isdir(os.path.join(BASE, "temp_ota_work")):
    print(f"  [!] {os.path.join(BASE, 'temp_ota_work')}/")
    found_junk = True
for root, dirs, _ in os.walk(BASE):
    dirs[:] = [d for d in dirs if d not in SKIP]
    for d in list(dirs):
        if d.startswith("extracted_"):
            print(f"  [!] {os.path.join(root, d)}/")
            found_junk = True
if not found_junk:
    print("  [OK] 无残留")

# ---------- 5. flet / flet_video 包数据（Nuitka 覆盖检查） ----------
print("\n📦 第三方包数据（Nuitka --include-package-data 覆盖）:")
import importlib.util
for pkg in ["flet", "flet_video"]:
    try:
        spec = importlib.util.find_spec(pkg)
        if not spec or not spec.submodule_search_locations:
            print(f"  {pkg}: [未安装]")
            continue
        pkg_dir = list(spec.submodule_search_locations)[0]
        data = 0
        for r, _, fs in os.walk(pkg_dir):
            for fn in fs:
                if not fn.endswith((".py", ".pyi", ".pyc")):
                    data += 1
        flag = "← 需要 --include-package-data=" + pkg if data else "（纯 py，OK）"
        print(f"  {pkg}: {pkg_dir}")
        print(f"    非 .py 数据文件: {data}  {flag}")
    except Exception as e:
        print(f"  {pkg}: [检查失败] {e}")

# ---------- 6. 结论 ----------
print("\n" + "=" * 70)
print("✅ 审计完成。看上面 4 段输出决定打包命令怎么补参数")
print("=" * 70)