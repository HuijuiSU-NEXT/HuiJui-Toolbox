import flet as ft
import os
import re
import glob
import shutil
import time
import subprocess
import threading
from core_api import CFG
from PIL import Image

BASE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

def build_settings_page(page: ft.Page, theme_color):
    state = {
        "theme_color": CFG.get("theme_color", "#39C5BB"),
        "ui_material": CFG.get("ui_material", "default"),
        "card_opacity": CFG.get("card_opacity", 0.15),
        "blur_radius": CFG.get("blur_radius", 10)
    }

    wallpaper_files = glob.glob(os.path.join(BASE_DIR, "assets", "wallpaper_*.*"))
    has_wallpaper = len(wallpaper_files) > 0

    def show_snackbar(msg, color=ft.Colors.GREEN):
        page.snack_bar = ft.SnackBar(content=ft.Text(msg, font_family="MiSans"), bgcolor=color)
        page.snack_bar.open = True
        page.update()

    def pick_wallpaper(e):
        file_picker = ft.FilePicker()
        page.overlay.append(file_picker)
        page.update()
        
        def on_file_selected(e: ft.FilePickerResultEvent):
            if e.files:
                src_path = e.files[0].path
                try:
                    ext = os.path.splitext(src_path)[1].lower()
                    new_filename = f"wallpaper_{int(time.time())}{ext}"
                    new_filepath = os.path.join(BASE_DIR, "assets", new_filename)

                    cover_path = os.path.join(BASE_DIR, "assets", "wallpaper_cover.jpg")
                    if os.path.exists(cover_path):
                        try: os.remove(cover_path)
                        except: pass

                    if ext in ['.mp4', '.webm', '.mov', '.mkv', '.avi']:
                        shutil.copy2(src_path, new_filepath)
                        ffmpeg_exe = os.path.join(BASE_DIR, "bin", "ffmpeg", "ffmpeg.exe")
                        if os.path.exists(ffmpeg_exe):
                            cmd_cover = [ffmpeg_exe, "-ss", "0.1", "-i", src_path, "-vframes", "1", "-q:v", "2", "-y", cover_path]
                            def _ffmpeg_cover():
                                try:
                                    subprocess.run(cmd_cover, check=True, capture_output=True, creationflags=subprocess.CREATE_NO_WINDOW if os.name == 'nt' else 0)
                                except Exception:
                                    pass
                            threading.Thread(target=_ffmpeg_cover, daemon=True).start()
                    elif ext in ['.jpg', '.jpeg', '.png', '.webp', '.bmp']:
                        img = Image.open(src_path).convert("RGB")
                        w, h = img.size
                        target_ratio = 16 / 10
                        if w / h > target_ratio:
                            new_w = int(h * target_ratio)
                            left = (w - new_w) // 2
                            img = img.crop((left, 0, left + new_w, h))
                        elif w / h < target_ratio:
                            new_h = int(w / target_ratio)
                            top = (h - new_h) // 2
                            img = img.crop((0, top, w, top + new_h))
                        img = img.resize((1440, 900), Image.Resampling.LANCZOS)
                        img.save(new_filepath, quality=95)
                    elif ext == '.gif':
                        shutil.copy2(src_path, new_filepath)
                    else:
                        raise Exception(f"不支持的格式: {ext}")

                    old_files = glob.glob(os.path.join(BASE_DIR, "assets", "wallpaper_*.*"))
                    for old_f in old_files:
                        if old_f != new_filepath and old_f != cover_path and os.path.exists(old_f):
                            try: os.remove(old_f)
                            except: pass
                    
                    if hasattr(page, "update_wallpaper_hot"):
                        page.update_wallpaper_hot()
                        
                    show_snackbar("高清壁纸已应用！")
                    
                except Exception as ex:
                    show_snackbar(f"应用失败: {ex}", ft.Colors.RED)

        file_picker.on_result = on_file_selected
        file_picker.pick_files(allowed_extensions=["jpg", "jpeg", "png", "webp", "gif", "bmp", "mp4", "webm", "mov", "mkv", "avi"])

    def clear_wallpaper(e):
        files = glob.glob(os.path.join(BASE_DIR, "assets", "wallpaper_*.*"))
        files.append(os.path.join(BASE_DIR, "assets", "wallpaper_cover.jpg"))
        for f in files:
            try: os.remove(f)
            except: pass
        if hasattr(page, "update_wallpaper_hot"):
            page.update_wallpaper_hot()
        show_snackbar("壁纸已清除。")

    color_input = ft.TextField(
        value=state["theme_color"], label="自定义 HEX 颜色", width=200, 
        bgcolor=ft.Colors.with_opacity(0.05, "#FFFFFF"), color="white", 
        border_color=ft.Colors.with_opacity(0.4, "#FFFFFF"), border_radius=8,
        text_style=ft.TextStyle(font_family="MiSans"), label_style=ft.TextStyle(color="#FFFFFF", weight=ft.FontWeight.W_600, font_family="MiSans")
    )
    color_preview = ft.Container(width=40, height=40, border_radius=8, bgcolor=state["theme_color"])
    def apply_color(e):
        hex_val = color_input.value.strip()
        if re.match(r'^#[0-9a-fA-F]{6}$', hex_val):
            state["theme_color"] = hex_val
            color_preview.bgcolor = hex_val
            CFG.set("theme_color", hex_val)
            CFG.save()
            show_snackbar("颜色已应用")
            if hasattr(page, "refresh_main_ui"): page.refresh_main_ui(tab_index=4)
        else:
            color_input.error_text = "格式错误"
        page.update()

    material_dropdown = ft.Dropdown(
        label="UI 材质", value=state["ui_material"], width=300, 
        bgcolor=ft.Colors.with_opacity(0.05, "#FFFFFF"), color="white", 
        border_color=ft.Colors.with_opacity(0.4, "#FFFFFF"), border_radius=8,
        text_style=ft.TextStyle(font_family="MiSans"), label_style=ft.TextStyle(color="#FFFFFF", weight=ft.FontWeight.W_600, font_family="MiSans"),
        options=[ft.dropdown.Option("default", "默认"), ft.dropdown.Option("frosted", "毛玻璃"), ft.dropdown.Option("liquid", "液态玻璃")], 
        on_change=lambda e: apply_material(e.control.value)
    )
    def apply_material(val):
        state["ui_material"] = val
        CFG.set("ui_material", val)
        CFG.save()
        if hasattr(page, "refresh_main_ui"): page.refresh_main_ui(tab_index=4)

    blur_slider = ft.Slider(min=0, max=40, divisions=40, value=state["blur_radius"], active_color=theme_color, label="{value}")
    blur_slider.on_change = lambda e: CFG.set("blur_radius", int(e.control.value))
    blur_slider.on_change_end = lambda e: page.refresh_main_ui(tab_index=4)

    opacity_slider = ft.Slider(min=0.05, max=0.8, divisions=15, value=state["card_opacity"], active_color=theme_color, label="{value}")
    opacity_slider.on_change = lambda e: CFG.set("card_opacity", e.control.value)
    opacity_slider.on_change_end = lambda e: page.refresh_main_ui(tab_index=4)

    def make_card(title, icon, content_list):
        return ft.Container(
            content=ft.Column([
                ft.Row([ft.Icon(icon, color=theme_color, size=20), ft.Text(title, size=16, weight=ft.FontWeight.BOLD, color="white", font_family="MiSans")]),
                ft.Divider(color=ft.Colors.with_opacity(0.2, ft.Colors.WHITE), height=10),
                *content_list
            ], spacing=15),
            bgcolor=page.ui_style.get("card_bg", ft.Colors.with_opacity(0.05, ft.Colors.WHITE)),
            border=page.ui_style.get("card_border", ft.border.all(1, theme_color)),
            border_radius=15, padding=20
        )

    card_step1 = make_card("第一步：壁纸引擎", ft.Icons.IMAGE, [
        ft.Row([
            ft.Column([ft.Text("自定义壁纸", size=14, color="white", font_family="MiSans"), ft.Text("支持高清 MP4 视频与静态图/GIF" if not has_wallpaper else "已设置壁纸，可随时更换", size=11, color="#FFFFFF", weight=ft.FontWeight.W_600, font_family="MiSans")]),
            ft.Container(expand=True),
            ft.ElevatedButton("选择图片/视频", icon=ft.Icons.UPLOAD, on_click=pick_wallpaper, style=ft.ButtonStyle(color="#FFFFFF", bgcolor=ft.Colors.with_opacity(0.2, theme_color), side=ft.BorderSide(1.5, theme_color), shape=ft.RoundedRectangleBorder(radius=8), text_style=ft.TextStyle(font_family="MiSans", weight=ft.FontWeight.W_600))),
            ft.ElevatedButton("清除壁纸", icon=ft.Icons.DELETE, on_click=clear_wallpaper, style=ft.ButtonStyle(color="#FFFFFF", bgcolor=ft.Colors.with_opacity(0.2, ft.Colors.RED_400), side=ft.BorderSide(1.5, ft.Colors.RED_400), shape=ft.RoundedRectangleBorder(radius=8), text_style=ft.TextStyle(font_family="MiSans", weight=ft.FontWeight.W_600)))
        ])
    ])
    card_step2 = make_card("第二步：主题色", ft.Icons.COLOR_LENS, [ft.Row([color_input, color_preview, ft.ElevatedButton("应用", on_click=apply_color, style=ft.ButtonStyle(color="#FFFFFF", bgcolor=ft.Colors.with_opacity(0.2, theme_color), side=ft.BorderSide(1.5, theme_color), shape=ft.RoundedRectangleBorder(radius=8), text_style=ft.TextStyle(font_family="MiSans", weight=ft.FontWeight.W_600)))])])
    card_step3 = make_card("第三步：UI 材质", ft.Icons.LAYERS, [ft.Text("选择全局材质", size=12, color="#FFFFFF", weight=ft.FontWeight.W_600, font_family="MiSans"), ft.Row([material_dropdown])])
    card_step4 = make_card("第四步：视觉特效", ft.Icons.AUTO_AWESOME, [
        ft.Row([ft.Column([ft.Text("全局模糊度", size=14, color="white", font_family="MiSans")]), ft.Container(expand=True), ft.Container(content=blur_slider, width=300)]),
        ft.Divider(color=ft.Colors.with_opacity(0.1, ft.Colors.WHITE), height=15),
        ft.Row([ft.Column([ft.Text("卡片透明度", size=14, color="white", font_family="MiSans")]), ft.Container(expand=True), ft.Container(content=opacity_slider, width=300)])
    ])

    return ft.Container(
        content=ft.Column([
            ft.Row([ft.Icon(ft.Icons.PALETTE, color=theme_color, size=28), ft.Text("个性化设置", size=24, weight=ft.FontWeight.BOLD, color="white", font_family="MiSans")]),
            ft.Container(height=10),
            ft.Column([card_step1, ft.Container(height=10), card_step2, ft.Container(height=10), card_step3, ft.Container(height=10), card_step4], scroll=ft.ScrollMode.AUTO, expand=True)
        ], expand=True),
        expand=True, padding=20
    )
