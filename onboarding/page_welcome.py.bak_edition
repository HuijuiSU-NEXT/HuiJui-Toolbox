import flet as ft
from .ui_glass_card import GlassCard
def build_welcome(t):
    return GlassCard(ft.Column([
        ft.Icon(ft.Icons.ROCKET_LAUNCH_ROUNDED, size=80, color=t),
        ft.Text("HuiJui Core", size=42, weight=ft.FontWeight.BOLD, color="white"),
        ft.Text("Matrix Engine · 为极客打造的底层矩阵", size=16, color="#94A3B8")
    ], alignment=ft.MainAxisAlignment.CENTER, horizontal_alignment=ft.CrossAxisAlignment.CENTER, spacing=20))
