# ====== 忽略虚拟环境 ======
venv/
venv_pack/
venv_android/
venv_linux/
__pycache__/
*.pyc

# ====== 忽略 Python 打包产物 ======
dist/
build/
*.dist/
*.build/
*.onefile-build/
*.spec
crash_log.txt
nuitka-crash-report.xml

# ====== 忽略巨大的可执行文件和压缩包 ======
*.exe
*.zip
*.7z

# ====== 忽略底层军火库 (体积太大，GitHub装不下) ======
bin/
mtkclient/

# ====== 忽略巨大的视频和背景图资源 ======
assets/wallpaper_*.mp4
assets/*.bak*
assets/wallpaper_cover.jpg

# ====== 忽略系统级缓存 ======
.vscode/
.idea/
*.log